{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "caps",
  "version": "0.1.0",
  "identifier": "com.caps.app",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "title": "caps",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],

    "security": {
      "csp": "default-src 'self' asset: ipc: http://ipc.localhost https://ipc.localhost; media-src 'self' blob: asset: http://asset.localhost https://asset.localhost; img-src 'self' asset: http://asset.localhost https://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval';",

      "assetProtocol": {
        "enable": true,
        "scope": [
          "$VIDEO/**/*",
          "$DOWNLOAD/**/*",
          "$DOCUMENT/**/*",
          "$DESKTOP/**/*"
        ]
      }
    }
  },

  "bundle": {
    "active": true,

    "targets": ["nsis"],
    "externalBin": ["binaries/ffmpeg"],

    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
